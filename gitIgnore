package com.lombardrisk.ruleengine

import com.lombardrisk.colline.stp.dto.ruledata.*;
import com.lombardrisk.colline.stp.QueryUtil;
import com.lombardrisk.colline.stp.StpServiceRemote;
import com.lombardrisk.colline.stp.beanfactory.StpBeanFactory;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.*;

rule "M_HUGE_AMOUNT"
dialect "java"
no-loop true

when
    $marginRuleData : MarginRuleData()
then

    StpServiceRemote ssr = StpBeanFactory.createStpService();
    Logger log = LoggerFactory.getLogger("com.lombardrisk.colline.stp.Rule");

    List amountList = QueryUtil.select(
        "ABS(ROUND((cw.agreementrequirement / " +
        "nci_eai$owner.f_get_fxrate(rd.refdatavalue, 'EUR', 1, SYSDATE)), 2)) " +
        "FROM colworkflow cw " +
        "INNER JOIN colagreementheader cah ON cah.id = cw.agreementid " +
        "INNER JOIN refdata rd ON rd.id = cah.basecurrency " +
        "WHERE cw.agreementid = " + $marginRuleData.agreement.agreementId + " " +
        "AND cw.actionid IN (51, 52) " +
        "AND used = 1"
    );

    Double amountEur = null;

    if (amountList != null && amountList.size() > 0 && amountList.get(0) != null) {
        log.info("M_HUGE_AMOUNT: amountList not null");
        amountEur = ((Number) amountList.get(0)).doubleValue();
    } else {
        log.info("M_HUGE_AMOUNT: amountList null or empty");
    }

    log.info("M_HUGE_AMOUNT: Agreement ID |" +
             $marginRuleData.agreement.agreementId +
             "| AMOUNT_EUR |" + amountEur);

    if (amountEur != null && amountEur > 250000000) {

        log.info("M_HUGE_AMOUNT: Agreement ID " +
                 $marginRuleData.agreement.agreementId +
                 " ->| Failed (Amount > 250M EUR)");

        modify ($marginRuleData) {
            result = false
        };

    } else {

        log.info("M_HUGE_AMOUNT: Agreement ID " +
                 $marginRuleData.agreement.agreementId +
                 " ->| Success");

        modify ($marginRuleData) {
            result = true
        };
    }

    log.info("M_HUGE_AMOUNT: Agreement ID " +
             $marginRuleData.agreement.agreementId +
             " ->| Exit");

end
