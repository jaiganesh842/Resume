package com.lombardrisk.ruleengine

import com.lombardrisk.colline.stp.dto.ruledata.MarginRuleData
import com.lombardrisk.colline.stp.StpServiceRemote
import com.lombardrisk.colline.stp.beanfactory.StpBeanFactory
import com.lombardrisk.colline.stp.QueryUtil
import org.slf4j.Logger
import org.slf4j.LoggerFactory

rule "M_HUGE_AMOUNT"
dialect "java"
no-loop true

when
    $marginRuleData : MarginRuleData()
then
    Logger log = LoggerFactory.getLogger("com.lombardrisk.colline.stp.Rule");

    long agreementId = $marginRuleData.getAgreement().getAgreementId();
    log.info("M_HUGE_AMOUNT : Agreement ID " + agreementId + " -> Entry");

    String query =
        "SELECT ABS(ROUND( " +
        " cw.agreementrequirement / " +
        " nci_eai$owner.f_get_fxrate(rd.refdatavalue, 'EUR', 1, SYSDATE), 2)) " +
        "FROM colworkflow cw " +
        "INNER JOIN colagreementheader cah ON cah.id = cw.agreementid " +
        "INNER JOIN refdata rd ON rd.id = cah.basecurrency " +
        "WHERE cw.agreementid = " + agreementId +
        " AND cw.actionid IN (51,52) " +
        " AND cw.used = 1";

    long cnt = 0;

    try {
        cnt = QueryUtil.count(
            "SELECT COUNT(*) FROM (" + query + ") WHERE 1=1",
            "1=1"
        );
        log.info("M_HUGE_AMOUNT : Row count = " + cnt);
    } catch (Throwable t) {
        log.error("M_HUGE_AMOUNT : QueryUtil.count failed", t);
    }

    boolean failed = false;

    if (cnt > 0) {
        failed = QueryUtil.count(
            "SELECT COUNT(*) FROM (" + query + ") WHERE AMOUNT >= 250000000",
            "1=1"
        ) > 0;
    }

    if (failed) {
        log.info("M_HUGE_AMOUNT : FAILED - Amount >= 250M EUR");
        modify($marginRuleData) { result = false }
    } else {
        log.info("M_HUGE_AMOUNT : PASSED - Amount < 250M EUR");
        modify($marginRuleData) { result = true }
    }

    log.info("M_HUGE_AMOUNT : Agreement ID " + agreementId + " -> Exit");
end
